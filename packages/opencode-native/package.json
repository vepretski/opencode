{
  "name": "@opencode-native/core",
  "version": "0.1.0",
  "description": "Native Rust modules for OpenCode performance optimization",
  "main": "./index.ts",
  "types": "./index.d.ts",
  "scripts": {
    "build": "napi build --release",
    "build:debug": "napi build",
    "test": "node test.js"
  },
  "napi": {
    "binaryName": "opencode-native",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "files": [
    "*.node",
    "*.d.ts",
    "*.js"
  ]
}

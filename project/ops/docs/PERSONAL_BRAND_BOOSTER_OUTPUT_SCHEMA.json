{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "personal-brand-booster-output-schema",
  "title": "Personal Brand Booster Output",
  "type": "object",
  "properties": {
    "brief": {
      "type": "object",
      "required": [
        "source_title",
        "one_line_thesis",
        "key_claims",
        "personal_brand_angle",
        "audience",
        "proof_points",
        "reusable_hooks",
        "source_reference"
      ]
    },
    "campaign_plan": {
      "type": "object",
      "required": ["objective", "languages", "channels", "cta_policy", "sync_policy", "source_reference"]
    },
    "validation": {
      "type": "object",
      "required": ["status", "files", "sync"],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "sync": {
          "type": "object",
          "required": ["has_manifest", "all_platforms_ready", "all_platform_files_valid"]
        }
      }
    }
  },
  "required": ["brief", "campaign_plan", "validation"]
}

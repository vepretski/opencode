rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role() { return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : "public"; }
    function isAdmin() { return role() == "admin"; }
    function canReview() { return role() in ["reviewer", "admin"]; }
    function canEditMagazine() { return role() in ["editor", "admin"]; }
    function canManageStartOn() { return role() in ["starton_manager", "admin"]; }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /civic_reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (resource.data.created_by == request.auth.uid || canReview());
      allow update: if canReview();
      allow delete: if isAdmin();
    }

    match /report_reviews/{reviewId} {
      allow read, write: if canReview();
    }

    match /civic_clusters/{clusterId} {
      allow read: if isSignedIn();
      allow write: if canReview();
    }

    match /insight_exports/{exportId} {
      allow read: if isSignedIn();
      allow write: if canReview();
    }

    match /magazine_drafts/{draftId} {
      allow read: if isSignedIn();
      allow write: if canEditMagazine();
    }

    match /starton_leads/{leadId} {
      allow create: if true;
      allow read, update: if canManageStartOn();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
